DEBUG=true
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Postgres uchun: postgresql+asyncpg://postgres:PAROL@localhost:5432/portfolio
DATABASE_URL=sqlite+aiosqlite:///./portfolio.db
# Bo'sh = rasm URL'lari nisbiy (/media/...), frontend orqali istalgan qurilmada ochiladi.
# Faqat rasmlar boshqa domendan berilsa to'ldiring, masalan: https://api.bahodirbek.uz
PUBLIC_BASE_URL=
CORS_ORIGINS=["http://localhost:3000"]
# Gmail manzili (yoki boshqa SMTP login)
SMTP_USER=you@example.com
SMTP_PASSWORD=
# Xatdagi yuboruvchi manzil. Bo'sh bo'lsa SMTP_USER ishlatiladi.
# Brevo misoli: SMTP_HOST=smtp-relay.brevo.com, SMTP_USER=<brevo login>, EMAIL_FROM=noreply@bahodirbek.uz
EMAIL_FROM=
